{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The reader window: window control and the open dialog, nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
