{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Volumen",
  "version": "0.1.0",
  "identifier": "app.volumen.reader",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5193",
    "beforeDevCommand": "npm --prefix ../app run dev",
    "beforeBuildCommand": "npm --prefix ../app run build"
  },
  "app": {
    "windows": [
      { "title": "Volumen", "width": 1280, "height": 860, "minWidth": 420, "minHeight": 420, "decorations": true, "backgroundColor": "#e9ebee" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Education"
  }
}
